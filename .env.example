# Supabase Configuration (Required for production auth, database, and storage)
# Get these values from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: domain suffix appended when signing in with a plain username on /admin
# (e.g. username "admin" maps to "admin@storybook.local")
VITE_ADMIN_USERNAME_DOMAIN=storybook.local
